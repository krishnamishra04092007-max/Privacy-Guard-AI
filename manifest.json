{
  "manifest_version": 3,
  "name": "Privacy Guard AI",
  "version": "1.0.0",
  "description": "Intelligent predatory legal terms auditor powered exclusively by Google Gemini AI.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Privacy Guard AI"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "icons": {
    "128": "public/icon-128.png"
  }
}